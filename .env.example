# Copy to .env. Everything except or_api_key is optional: without keys, Harbourline uses
# its built-in demo adapters (demo mailbox, demo bank, demo ledger). See docs/SETUP_INTEGRATIONS.md.

# Product LLM (OpenRouter), used only by the running product
or_api_key=
LLM_MODEL=google/gemini-3.8-flash
LLM_REASONING=low

DATABASE_URL=postgres://localhost/harbourline
APP_URL=http://localhost:3000
# 32+ random characters; encrypts ID numbers, addresses and stored credentials
APP_SECRET=

# The address you'll email from to show an existing client (CHAN Tai Man, Kowloon Bay Trading)
DEMO_EXISTING_CLIENT_EMAIL=

# Email: Gmail (preferred) or AgentMail (fallback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ADDRESS=
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=
# MAIL_PROVIDER=gmail|agentmail|fake  (defaults to whichever keys are present)

# Airwallex sandbox
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api-demo.airwallex.com
AIRWALLEX_GLOBAL_ACCOUNT_ID=

# Xero (custom connection or bearer token) via the Xero MCP server
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_CLIENT_BEARER_TOKEN=
XERO_SALES_ACCOUNT_CODE=200
XERO_BANK_ACCOUNT_CODE=090

# Screening (optional; without it the local OpenSanctions sanctions list is used)
OPENSANCTIONS_API_KEY=

POLL_INTERVAL_MS=5000
