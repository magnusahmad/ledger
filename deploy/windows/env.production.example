# Clerk pilot installation config (no secrets here: those go in secrets.json via secrets.ps1).
INSTALLATION=production
# The client this installation is for. Its profile (clients/uhy/installation.ts) sets the modules,
# the firm id, the firm's email domain and its own filing rules and email template; a line here
# overrides the profile.
INSTALLATION_PROFILE=uhy
APP_URL=https://clerk.uhyask.local
# The model reads client replies on cases and proposes; staff review every point (DECISIONS.md #64).
# Set AR_REPLY_READER=0 to run with no AI at all: then no OpenRouter key is needed and LLM_MODE can be removed.
AR_REPLY_READER=1
LLM_MODE=live
LLM_MODEL=google/gemini-3.8-flash
DEMO_TOOLS=0
MAIL_PROVIDER=fake
STORAGE_DIR=C:\ProgramData\Clerk\storage
# Team mailboxes (Microsoft 365), comma-separated.
PILOT_MAILBOXES=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CERT_THUMBPRINT=
# Restored CSA copy (clients/uhy/ops/csa-restore.ps1) and the mapping written on site.
# CSA_SQL_CONNECTION is a secret (it holds the reader password): set it with secrets.ps1 as
#   Server=localhost\SQLEXPRESS;Database=CSA_Copy;User Id=clerk_reader;Password=...;Encrypt=true;TrustServerCertificate=true
CSA_MAPPING_FILE=C:\Clerk\config\csa-mapping.json
CSA_RESTORE_STATUS_FILE=C:\ProgramData\Clerk\csa\restore-status.json
# The share mapped as F: (UNC path, confirmed by Topone) and a folder there for the status workbook.
FILING_ROOT=
STATUS_DIR=
