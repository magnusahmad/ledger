{
  "name": "ao1-clerk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,green \"next dev\" \"tsx watch --env-file-if-exists=.env src/worker/main.ts\"",
    "dev:web": "next dev",
    "worker": "tsx --env-file-if-exists=.env src/worker/main.ts",
    "build:stamp": "node scripts/build-stamp.mjs",
    "prebuild": "node scripts/build-stamp.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset.ts",
    "eval:llm": "tsx --env-file-if-exists=.env scripts/eval-llm.ts",
    "eval:ar-replies": "tsx scripts/eval-ar-replies.ts",
    "forms:check": "tsx --env-file-if-exists=.env scripts/forms-check.ts",
    "screening:update": "tsx --env-file-if-exists=.env scripts/screening-update.ts",
    "demo:pay": "tsx --env-file-if-exists=.env scripts/demo-pay.ts",
    "demo:rehearse": "tsx --env-file-if-exists=.env scripts/rehearse.ts",
    "mailroom:dev": "DATABASE_URL=postgres://localhost/clerk_cwc FIRM_ID=firm_cwc STORAGE_DIR=storage/cwccpa MAIL_PROVIDER=fake NEXT_DIST_DIR=.next-mailroom AIRWALLEX_CLIENT_ID= AIRWALLEX_API_KEY= XERO_CLIENT_ID= XERO_CLIENT_SECRET= XERO_CLIENT_BEARER_TOKEN= concurrently -k -n web,mailroom -c blue,green \"next dev -p 3100\" \"tsx watch --env-file-if-exists=.env src/worker/mailroom.ts\"",
    "mailroom:reset": "DATABASE_URL=postgres://localhost/clerk_cwc FIRM_ID=firm_cwc STORAGE_DIR=storage/cwccpa MAIL_PROVIDER=fake tsx --env-file-if-exists=.env scripts/mailroom-reset.ts",
    "mailroom:pack": "tsx scripts/mailroom-pack.ts",
    "mailroom:record": "DATABASE_URL=postgres://localhost/clerk_cwc FIRM_ID=firm_cwc STORAGE_DIR=storage/cwccpa MAIL_PROVIDER=fake MAILROOM_RECORD=1 tsx --env-file-if-exists=.env scripts/mailroom-record.ts",
    "mailroom:live": "DATABASE_URL=postgres://localhost/clerk_cwc FIRM_ID=firm_cwc STORAGE_DIR=storage/cwccpa MAIL_PROVIDER=fake LLM_MODE=live MAILROOM_REPLAY=0 NEXT_DIST_DIR=.next-mailroom AIRWALLEX_CLIENT_ID= AIRWALLEX_API_KEY= XERO_CLIENT_ID= XERO_CLIENT_SECRET= XERO_CLIENT_BEARER_TOKEN= concurrently -k -n web,mailroom -c blue,green \"next dev -p 3100\" \"tsx watch --env-file-if-exists=.env src/worker/mailroom.ts\"",
    "worker:annual": "tsx --env-file-if-exists=.env src/worker/annual.ts",
    "user:add": "tsx --env-file-if-exists=.env scripts/user-add.ts",
    "firm:init": "tsx --env-file-if-exists=.env scripts/firm-init.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "agentmail": "^0.5.31",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "googleapis": "^182.0.0",
    "mailparser": "^3.9.31",
    "mdb-reader": "^3.2.0",
    "mssql": "^11.0.2",
    "nanoid": "^6.0.1",
    "next": "16.3.7",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tsx": "^4.23.15",
