{
  "name": "harbourline-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,green \"next dev\" \"tsx watch --env-file-if-exists=.env src/worker/main.ts\"",
    "dev:web": "next dev",
    "worker": "tsx --env-file-if-exists=.env src/worker/main.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/reset.ts",
    "eval:llm": "tsx --env-file-if-exists=.env scripts/eval-llm.ts",
    "forms:check": "tsx --env-file-if-exists=.env scripts/forms-check.ts",
    "screening:update": "tsx --env-file-if-exists=.env scripts/screening-update.ts",
    "demo:pay": "tsx --env-file-if-exists=.env scripts/demo-pay.ts",
    "demo:rehearse": "tsx --env-file-if-exists=.env scripts/rehearse.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "agentmail": "^0.5.31",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "googleapis": "^182.0.0",
    "mailparser": "^3.9.31",
    "nanoid": "^6.0.1",
    "next": "16.3.7",
    "nodemailer": "^10.0.12",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pg-boss": "^12.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv": "^18.0.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
